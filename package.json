{
  "name": "@useplura/chat",
  "version": "0.2.1",
  "description": "Embeddable chat widget for usePlura flows",
  "type": "module",
  "license": "MIT",
  "author": "Plura AI LLC",
  "homepage": "https://plura.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/plura-ai/chat-widget"
  },
  "keywords": ["chat", "widget", "plura", "embed", "websocket"],
  "files": [
    "dist/lib",
    "dist/embed",
    "scripts",
    "README.md"
  ],
  "main": "./dist/lib/index.cjs",
  "module": "./dist/lib/index.mjs",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/lib/index.mjs",
      "require": "./dist/lib/index.cjs",
      "types": "./dist/lib/index.d.ts"
    },
    "./element": {
      "import": "./dist/lib/element.mjs",
      "require": "./dist/lib/element.cjs",
      "types": "./dist/lib/element.d.ts"
    },
    "./embed": "./dist/embed/embed.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --mode lib && tsc -p tsconfig.lib.json",
    "build:embed": "vite build --mode embed",
    "build:all": "npm run build:lib && npm run build:embed",
    "lint": "eslint .",
    "preview": "vite preview",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "npm run build:all"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.5.4"
  }
}
